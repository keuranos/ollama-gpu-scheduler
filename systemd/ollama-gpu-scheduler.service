[Unit]
Description=Ollama GPU scheduler - single admission controller for all ollama traffic
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/ollama-gpu-scheduler/ollama_gpu_scheduler.py --config %h/ollama-gpu-scheduler/config.json
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=300

[Install]
WantedBy=default.target